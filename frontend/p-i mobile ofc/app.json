{
  "expo": {
    "name": "Nosso Sangue",
    "slug": "nosso-sangue",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nossosangue",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#ffffff" }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}